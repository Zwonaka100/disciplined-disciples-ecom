rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'zmabege@gmail.com' ||
        request.auth.token.email == 'nomaqhizazolile@gmail.com'
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024; // Max 5MB
    }

    // Product images - public read, admin-only write (validated images, max 5MB).
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Blog images - admins can upload, everyone can view
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Community images - authenticated users can upload their own
    match /community/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // Per-user invoices (private). Direct reads only by the owner or admin.
    // External shares use short-lived signed URLs generated by Cloud Functions.
    match /invoices/{userId}/{allPaths=**} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if false; // server-only via Admin SDK
    }

    // Ebook master files (private). Only admins read directly; customers receive
    // a signed URL from the getEbookDownloadLink callable.
    match /ebook/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
