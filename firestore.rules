rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let email = request.auth.token.email;
      let dynamicAdmins = get(/databases/$(database)/documents/siteSettings/main).data.team.adminsList;
      return isSignedIn() && (
        email == 'zmabege@gmail.com' ||
        email == 'nomaqhizazolile@gmail.com' ||
        (dynamicAdmins is list && email in dynamicAdmins)
      );
    }

    function isUserSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Allow authenticated users to read and write their own user profile; admins can manage all profiles
    match /artifacts/default-app-id/users/{userId} {
      allow read: if isUserSelf(userId) || isAdmin();
      allow write: if isUserSelf(userId) || isAdmin();
    }

    // Orders. Customers create their own orders in an unpaid state only; payment
    // status is set exclusively by the PayFast webhook (Admin SDK) or an admin.
    match /artifacts/default-app-id/orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.paymentStatus in ['Pending', 'Pending Payment']
        && request.resource.data.statusKey == 'pending_payment'
        && !request.resource.data.keys().hasAny([
          'paymentCompletedAt', 'paymentReference', 'payfastTxnId', 'webhookReceivedAt',
          'confirmationEmailSentAt', 'invoicePath', 'invoiceUrl', 'amountPaid',
          'paymentVerification', 'paymentReview'
        ]);
      allow read: if (isSignedIn() && request.auth.uid == resource.data.userId) || isAdmin();
      // The only thing a customer may record is that they came back from PayFast,
      // which admin sees as a hint when a payment confirmation is late.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerReturnedAt']));
      // Customers can remove their own unpaid orders from their history.
      allow delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId
            && resource.data.paymentStatus in ['Pending', 'Pending Payment', 'pending']);
    }

    // Allow authenticated users to create and read their own support requests; admins can assist
    match /artifacts/default-app-id/support-requests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if (isSignedIn() && request.auth.uid == resource.data.userId) || isAdmin();
      allow update: if (isSignedIn() && request.auth.uid == resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products - public read, admin-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blogs - public read, admin-only write
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog comments - anyone can read; signed-in users can create their own; admins or comment owner can delete
    match /blogs/{blogId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 800;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update: if false;
    }

    // Test document - restricted to signed-in users only
    match /test/{document} {
      allow read, write: if isSignedIn();
    }

    // Contact messages - anyone can create; only admins can read/update/delete
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Site content controls - public read for the docs the public pages render, admin write.
    // ('mentorship' is the pre-Academy content doc; it is kept for history but no longer shown.)
    match /siteContent/{docId} {
      allow read: if docId in ['book', 'homepageControls', 'about', 'academy', 'journal', 'speaking'] || isAdmin();
      allow write: if isAdmin();
    }

    // Free Chapter 1 requests from the homepage - anyone can submit an email; admin-only after that.
    match /chapterLeads/{leadId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() > 4
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.keys().hasOnly(['email', 'source', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // Speaking enquiries from speaking.html - public submit, admin manages.
    match /speakingEnquiries/{enquiryId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 140
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.organisation is string
        && request.resource.data.organisation.size() <= 200
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 3000
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'organisation', 'eventDate', 'eventType', 'format',
          'location', 'audienceSize', 'topic', 'budget', 'message', 'status', 'source', 'createdAt'
        ]);
      allow read, update, delete: if isAdmin();
    }

    // 30-Day Journal.
    // journalAccess is granted by the server (paid Academy package or journal purchase) or an admin.
    match /journalAccess/{uid} {
      allow read: if isUserSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    function hasJournalAccess() {
      return exists(/databases/$(database)/documents/journalAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/journalAccess/$(request.auth.uid)).data.granted == true;
    }

    // Journal settings, Day 0 answers and entries are private to the writer.
    // Admins (including the mentor) cannot read them.
    match /journals/{uid} {
      allow read, write: if isUserSelf(uid);
      match /entries/{entryId} {
        allow read, delete: if isUserSelf(uid);
        // Days 1-3 are a free sample; everything else needs journal access.
        allow create, update: if isUserSelf(uid)
          && (hasJournalAccess()
              || (request.resource.data.kind == 'day'
                  && request.resource.data.day is int
                  && request.resource.data.day <= 3));
      }
    }

    // Progress summary (days completed, practices ticked - no written content).
    // The mentor can read it only while the user has chosen to share it.
    match /journalProgress/{uid} {
      allow read: if isUserSelf(uid) || (isAdmin() && resource.data.shareWithMentor == true);
      // The email on the summary must be the writer's own sign-in email (the mentor view matches on it).
      allow write: if isUserSelf(uid)
        && request.resource.data.get('email', '') == request.auth.token.get('email', '').lower();
    }

    // Server-only records.
    match /paymentNotifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /ebookDownloadTokens/{id} {
      allow read, write: if false;
    }

    // Site settings (D7 admin settings page) - publicly readable so frontend can
    // pick up brand/homepage/shipping/legal values; only admins can write.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Academy (formerly Mentorship) applications - public submit, admin manages pipeline.
    // New applications always start unpaid; only the PayFast webhook or an admin can mark them paid.
    match /mentorshipApplications/{applicationId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.goal is string
        && request.resource.data.goal.size() > 0
        && request.resource.data.goal.size() <= 3000
        && request.resource.data.get('paymentStatus', 'Pending') in ['Pending', 'N/A']
        && request.resource.data.get('status', 'new') == 'new'
        && !request.resource.data.keys().hasAny([
          'amountPaid', 'paymentCompletedAt', 'paymentReference', 'paymentVerification',
          'paymentReview', 'invoicePath', 'webhookReceivedAt'
        ])
        && (request.resource.data.get('userId', null) == null
            || (isSignedIn() && request.resource.data.userId == request.auth.uid));
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Mentorship programs - admin only
    match /mentorshipPrograms/{programId} {
      allow read, write: if isAdmin();
    }

    // Collaboration leads - admin only
    match /collaborationLeads/{leadId} {
      allow read, write: if isAdmin();
    }

    // Community stories - public can read approved items; admin manages all
    match /communityStories/{storyId} {
      allow read: if isAdmin() || (resource.data.approved == true);
      allow write: if isAdmin();
    }

    // Admin activity log - admin only
    match /adminActivity/{activityId} {
      allow read, write: if isAdmin();
    }

    // Ebook entitlements - each user can read their own; only admins write (server uses Admin SDK)
    match /ebookEntitlements/{userId} {
      allow read: if isUserSelf(userId) || isAdmin();
      allow write: if isAdmin();
      match /items/{itemId} {
        allow read: if isUserSelf(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Email logs - admin only (server writes via Admin SDK)
    match /emailLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Recovery requests - admin only; processed by a Cloud Function trigger
    match /recoveryRequests/{requestId} {
      allow read, write: if isAdmin();
    }

    // Broadcast jobs - admins create + read; only Cloud Function (Admin SDK) updates status/counters
    match /broadcastJobs/{jobId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.bodyHtml is string
        && request.resource.data.bodyHtml.size() > 0
        && request.resource.data.totalRecipients is int
        && request.resource.data.totalRecipients >= 0
        && request.resource.data.totalRecipients <= 5000
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Inbox threads (D3) - admin-only read/update/delete; writes happen via
    // Cloud Function triggers (Admin SDK bypasses these rules). Admin can
    // toggle status/unread directly from the UI.
    match /inboxThreads/{threadId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
      match /messages/{messageId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}